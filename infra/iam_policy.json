{
  "Version": "2012-10-17",
  "Comment": "Least-privilege policy for the FloodLens datasets_api Lambda. Read-only GetObject on the processed bucket prefix only. ACCOUNT_ID and REGION are placeholders.",
  "Statement": [
    {
      "Sid": "ReadProcessedGeoJSON",
      "Effect": "Allow",
      "Action": ["s3:GetObject"],
      "Resource": "arn:aws:s3:::floodlens-processed-ACCOUNT_ID/processed/*"
    },
    {
      "Sid": "LambdaLogs",
      "Effect": "Allow",
      "Action": [
        "logs:CreateLogGroup",
        "logs:CreateLogStream",
        "logs:PutLogEvents"
      ],
      "Resource": "arn:aws:logs:REGION:ACCOUNT_ID:log-group:/aws/lambda/floodlens-datasets-api:*"
    }
  ]
}
