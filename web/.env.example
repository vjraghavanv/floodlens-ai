# FloodLens AI frontend environment
# ---------------------------------------------------------------------------
# LOCAL / DEMO MODE (default): leave everything empty. The app serves bundled
# GeoJSON from /data and uses a free OpenStreetMap raster basemap. No AWS needed.
# ---------------------------------------------------------------------------

# AWS data API (API Gateway invoke URL from the SAM stack output ApiBaseUrl).
# When set, the app reads datasets from this REST API instead of bundled files.
VITE_API_BASE=

# If true, AWS mode falls back to bundled demo data when the API is unreachable.
VITE_FALLBACK_TO_DEMO=true

# OPTIONAL: Amazon Location Service map style.
# Leave empty to use the open OSM raster basemap. When set, the map renders via
# Amazon Location Service. VITE_LOCATION_API_KEY is a scoped, public map-read
# API key (NOT an AWS secret) — inject it via Amplify env vars, never commit it.
VITE_LOCATION_STYLE_URL=
VITE_LOCATION_API_KEY=
